# Neon connection string (Vercel > Storage > Neon adds DATABASE_URL automatically).
# Leave unset locally to use the file-backed store in .data/
DATABASE_URL=

# Required in production: long random string used to sign session cookies.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Used once by `npm run init-db` to create the first admin (EMP-101). Min 10 chars.
ADMIN_EMAIL=thanseemca@gmail.com
ADMIN_INITIAL_PASSWORD=
